generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  DELIVERY_AGENT
}

enum AddressLabel {
  HOME
  WORK
  OTHER
}

enum OrderType {
  DELIVERY
  TAKEAWAY
  DINE_IN
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  REJECTED
  CANCELLED
}

// Only COD and a manually-confirmed UPI QR today — a 3rd value (e.g.
// GATEWAY for Razorpay) can be added later without restructuring Order.
enum PaymentMethod {
  COD
  UPI_MANUAL
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum CouponType {
  FLAT
  PERCENT
}

model User {
  id                   String                @id @default(cuid())
  role                 Role
  name                 String
  phone                String?               @unique
  email                String?               @unique
  passwordHash         String?
  isBlocked            Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  addresses            Address[]
  orders               Order[]               @relation("CustomerOrders")
  reviews              Review[]
  deliveryAgentProfile DeliveryAgentProfile?
  assignedOrders       Order[]               @relation("AgentOrders")
  favorites            Favorite[]

  @@index([role])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, menuItemId])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

model Address {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     AddressLabel @default(HOME)
  line1     String
  landmark  String?
  area      String
  city      String
  pincode   String
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  orders    Order[]

  @@index([userId])
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  sortOrder Int        @default(0)
  menuItems MenuItem[]
}

model MenuItem {
  id          String      @id @default(cuid())
  name        String
  description String?
  price       Decimal     @db.Decimal(10, 2)
  imageUrl    String?
  isVeg       Boolean     @default(true)
  available   Boolean     @default(true)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  comboItems  ComboItem[]
  orderItems  OrderItem[]
  favoritedBy Favorite[]

  @@index([categoryId])
}

model Combo {
  id          String      @id @default(cuid())
  name        String
  description String?
  price       Decimal     @db.Decimal(10, 2)
  imageUrl    String?
  available   Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  items       ComboItem[]
  orderItems  OrderItem[]
}

// Lets sellers allow substitution within a combo slot (e.g. swap the
// included noodles for fried rice) rather than a fixed, uneditable set.
model ComboItem {
  id         String   @id @default(cuid())
  comboId    String
  combo      Combo    @relation(fields: [comboId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int      @default(1)
  swappable  Boolean  @default(false)

  @@index([comboId])
}

model Coupon {
  id            String     @id @default(cuid())
  code          String     @unique
  type          CouponType
  value         Decimal    @db.Decimal(10, 2)
  minOrderValue Decimal    @default(0) @db.Decimal(10, 2)
  maxDiscount   Decimal?   @db.Decimal(10, 2)
  validFrom     DateTime
  validTo       DateTime
  usageLimit    Int?
  usedCount     Int        @default(0)
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  orders        Order[]
}

model Order {
  id                  String        @id @default(cuid())
  orderNumber         String        @unique
  customerId          String
  customer            User          @relation("CustomerOrders", fields: [customerId], references: [id])
  addressId           String?
  address             Address?      @relation(fields: [addressId], references: [id])
  type                OrderType
  status              OrderStatus   @default(PLACED)
  paymentMethod       PaymentMethod
  paymentStatus       PaymentStatus @default(UNPAID)
  itemsTotal          Decimal       @db.Decimal(10, 2)
  deliveryFee         Decimal       @default(0) @db.Decimal(10, 2)
  taxAmount           Decimal       @default(0) @db.Decimal(10, 2)
  discountAmount      Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount         Decimal       @db.Decimal(10, 2)
  couponId            String?
  coupon              Coupon?       @relation(fields: [couponId], references: [id])
  deliveryAgentId     String?
  deliveryAgent       User?         @relation("AgentOrders", fields: [deliveryAgentId], references: [id])
  specialInstructions String?
  placedAt            DateTime      @default(now())
  confirmedAt         DateTime?
  preparingAt         DateTime?
  readyAt             DateTime?
  outForDeliveryAt    DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  items               OrderItem[]
  review              Review?

  @@index([customerId])
  @@index([deliveryAgentId])
  @@index([status])
}

// Snapshots name/price at order time so a later menu edit never rewrites
// history. Exactly one of menuItemId/comboId is set per row.
model OrderItem {
  id              String    @id @default(cuid())
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId      String?
  menuItem        MenuItem? @relation(fields: [menuItemId], references: [id])
  comboId         String?
  combo           Combo?    @relation(fields: [comboId], references: [id])
  name            String
  quantity        Int
  priceAtOrder    Decimal   @db.Decimal(10, 2)
  // { swaps: [{ fromMenuItemId, toMenuItemId }] }
  comboSelections Json?

  @@index([orderId])
}

model Review {
  id         String   @id @default(cuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId String
  customer   User     @relation(fields: [customerId], references: [id])
  rating     Int
  comment    String?
  // { [orderItemId]: rating }
  itemRatings Json?
  createdAt  DateTime @default(now())

  @@index([customerId])
}

// Singleton row, id is always the literal "shop_config".
model ShopConfig {
  id            String   @id @default("shop_config")
  name          String   @default("Bite Corner")
  // Flat fee, same for every delivery address — no distance is computed or
  // stored anywhere.
  deliveryFee   Decimal  @default(0) @db.Decimal(10, 2)
  minOrderValue Decimal  @default(0) @db.Decimal(10, 2)
  taxPercent    Decimal  @default(0) @db.Decimal(5, 2)
  openTime      String   @default("11:00")
  closeTime     String   @default("23:00")
  address       String?
  // Static UPI VPA rendered client-side as a QR — not per-transaction.
  upiId         String?
  whatsappNumber String?
  updatedAt     DateTime @updatedAt
}

model DeliveryAgentProfile {
  userId        String  @id
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleNumber String?
  isAvailable   Boolean @default(true)
  // Admin-toggled "deactivated" flag — also revokes portal login, not just
  // new-order assignment.
  isActive      Boolean @default(true)
}
