# Copy to .env and fill in real values.

NODE_ENV=development
PORT=4002

# Local Postgres — a separate "bitecorner" database, created on the same
# local Postgres server as any other project on this machine. Connecting
# role here reuses an existing DB login that already has CREATEDB on that
# server (it lacked CREATEROLE, so a dedicated "bitecorner" role wasn't
# created) — swap this for a real dedicated role/password in production.
DATABASE_URL="postgresql://rrkitchen:rrkitchen@localhost:5432/bitecorner"

# Any long random string in dev; use a real secret in production
JWT_SECRET="change-me-to-a-long-random-string-bc"
JWT_EXPIRES_IN="7d"

# The Next.js app's origin, for CORS + cookies
WEB_ORIGIN="http://localhost:3002"

OTP_TTL_MINUTES=5
